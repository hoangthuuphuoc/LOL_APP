<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_skill_box"
        android:layout_width="90dp"
        android:layout_height="90dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/view_border_back"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_skill_selected"
            android:visibility="invisible"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintBottom_toBottomOf="@id/iv_skill"
            app:layout_constraintEnd_toEndOf="@id/iv_skill" />

        <ImageView
            android:id="@+id/iv_skill"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:padding="10dp"
            android:scaleType="fitXY"
            android:src="@drawable/im_skill"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <View
            android:id="@+id/view_border_front"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="23dp"
            android:background="@drawable/bg_skill_selected"
            android:visibility="invisible"
            app:layout_constraintStart_toStartOf="@id/iv_skill"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/view_skill_connect"
        android:layout_width="3dp"
        android:layout_height="36dp"
        android:background="#9B00FF"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="@id/layout_skill_box"
        app:layout_constraintStart_toStartOf="@id/layout_skill_box"
        app:layout_constraintTop_toBottomOf="@id/layout_skill_box" />

</androidx.constraintlayout.widget.ConstraintLayout>