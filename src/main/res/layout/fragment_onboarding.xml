<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <ImageView
        android:id="@+id/iv_img_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/img_bg_fragment1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.62"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/view_fade_bottom"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_image_fade_bottom"
        app:layout_constraintBottom_toBottomOf="@id/iv_img_bg"
        app:layout_constraintEnd_toEndOf="@id/iv_img_bg"
        app:layout_constraintStart_toStartOf="@id/iv_img_bg" />

    <ImageView
        android:id="@+id/iv_game"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="95dp"
        android:layout_marginTop="105dp"
        android:src="@drawable/ic_game"
        app:layout_constraintStart_toStartOf="@id/iv_img_bg"
        app:layout_constraintTop_toTopOf="@id/iv_img_bg" />

    <ImageView
        android:id="@+id/iv_play"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="75dp"
        android:layout_marginBottom="15dp"
        android:src="@drawable/ic_play"
        app:layout_constraintBottom_toBottomOf="@id/iv_img_bg"
        app:layout_constraintEnd_toEndOf="@id/iv_img_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_img_bg">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/font_bold"
            android:gravity="center"
            android:padding="20dp"
            android:text="Escolha os melhores
campeões"
            android:textColor="@color/white"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/tv_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="20dp"
            android:text="Os melhores campeões, builds,
match-ups e tudo o que você precisa
para melhorar no jogo."
            android:textColor="@color/gray_light"
            android:textSize="20sp" />

        <ImageView
            android:id="@+id/iv_next"
            android:layout_width="51dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_button"
            android:padding="15dp"
            android:src="@drawable/ic_arrow" />

        <TextView
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_button_fragment2"
            android:gravity="center"
            android:text="Vamos lá!"
            android:textColor="@color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>